# ============================================================
# COGNITIVE FIRE DEFENSE PIPELINE — .gitignore
# ML Research Project | Python + Jupyter
# ============================================================

# ──────────────────────────────────────────────
# DATASETS — Never commit raw image data
# ──────────────────────────────────────────────
dataset-a/raw/
dataset-a/processed/
dataset-b/raw/
dataset-b/processed/
dataset-a/**/*.zip
dataset-b/**/*.zip
dataset-a/**/*.tar.gz
dataset-b/**/*.tar.gz
*.db
*.sqlite

# Keep annotations, READMEs, notebooks, results metrics
!dataset-a/**/annotations/
!dataset-b/**/annotations/
!dataset-a/**/README.md
!dataset-b/**/README.md
!dataset-a/**/*.ipynb
!dataset-b/**/*.ipynb
!dataset-a/**/results/*.json
!dataset-b/**/results/*.json
!dataset-a/**/results/*.csv

# ──────────────────────────────────────────────
# MODEL WEIGHTS — Large binary files
# ──────────────────────────────────────────────
*.pt
*.pth
*.onnx
*.tflite
*.pkl
*.pickle
*.h5
*.hdf5

# ──────────────────────────────────────────────
# RESULTS & LOGS
# ──────────────────────────────────────────────
wandb/
runs/
tensorboard/
*.log
results/**/*.onnx

# ──────────────────────────────────────────────
# PYTHON
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ──────────────────────────────────────────────
# JUPYTER
# ──────────────────────────────────────────────
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ──────────────────────────────────────────────
# KAGGLE
# ──────────────────────────────────────────────
kaggle.json
.kaggle/

# ──────────────────────────────────────────────
# ENVIRONMENTS
# ──────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ──────────────────────────────────────────────
# IDE / OS
# ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
