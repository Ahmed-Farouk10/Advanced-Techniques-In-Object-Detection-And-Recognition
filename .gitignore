# ============================================================
# COGNITIVE FIRE DEFENSE PIPELINE - .gitignore
# ML Research Project | Python + Jupyter
# ============================================================

# ──────────────────────────────────────────────
# DATASETS — Never commit raw image data
# ──────────────────────────────────────────────
dataset-a/raw/
dataset-a/processed/
dataset-b/raw/
dataset-b/processed/
dataset-a/**/*.zip
dataset-b/**/*.zip
dataset-a/**/*.tar.gz
dataset-b/**/*.tar.gz
*.db
*.sqlite

# Generated dataset splits (large; reproducible via build scripts)
dataset-b/yolo_format/
dataset-b/coco_format/
Boreal-Dataset/

# Keep annotations, READMEs, notebooks, results metrics
!dataset-a/**/annotations/
!dataset-b/**/annotations/
!dataset-a/**/README.md
!dataset-b/**/README.md
!dataset-a/**/*.ipynb
!dataset-b/**/*.ipynb
!dataset-a/**/results/*.json
!dataset-b/**/results/*.json
!dataset-a/**/results/*.csv
!dataset-b/**/results/*.csv

# ──────────────────────────────────────────────
# MODEL WEIGHTS — Large binary files
# ──────────────────────────────────────────────
*.pt
*.pth
*.onnx
*.tflite
*.pkl
*.pickle
*.h5
*.hdf5
*.safetensors
*.bin
results/**/*.pt
results/**/*.pth
results/**/*.onnx

# ──────────────────────────────────────────────
# PAPER ARTEFACTS
# ──────────────────────────────────────────────
# Downloaded reference PDFs (copyrighted — use DOI list in literature_comparison_matrix.md)
paper/references/
# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.bbl
*.blg
# Node/Puppeteer PDF tooling
paper/node_modules/
package-lock.json
# Installers and bundled binaries
*.msi
tectonic_bin/
paper/test.tex

# ──────────────────────────────────────────────
# PYTHON
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ──────────────────────────────────────────────
# JUPYTER NOTEBOOKS — Strip outputs before commit
# ──────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ──────────────────────────────────────────────
# ML EXPERIMENT TRACKING
# ──────────────────────────────────────────────
wandb/
mlruns/
runs/
lightning_logs/
.neptune/

# Ultralytics YOLO runs
runs/
ultralytics/

# HuggingFace cache
.cache/
~/.cache/huggingface/

# ──────────────────────────────────────────────
# KAGGLE CREDENTIALS — NEVER commit
# ──────────────────────────────────────────────
kaggle.json
.kaggle/
*.json.bak
*_credentials*

# ──────────────────────────────────────────────
# COLAB / GOOGLE DRIVE ARTEFACTS
# ──────────────────────────────────────────────
*.gdrive
sample_data/
drive/

# ──────────────────────────────────────────────
# OS & EDITOR JUNK
# ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# VS Code
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml
*.iws

# ──────────────────────────────────────────────
# LOGS & TEMP
# ──────────────────────────────────────────────
*.log
*.tmp
*.temp
logs/
tmp/
temp/

# ──────────────────────────────────────────────
# AG KIT — Internal tooling (not for repo consumers)
# ──────────────────────────────────────────────
.agents/

# Old flat structure (archived)
ara-output/

# ──────────────────────────────────────────────
# AI-Research-SKILLs — Separate git repo (submodule)
# ──────────────────────────────────────────────
# AI-Research-SKILLs/

# ──────────────────────────────────────────────
# PAPER FIGURES
# (EDA figures are small (<250 KB) and required for PDF compilation —
#  track them. Only exclude oversized generated outputs if any appear.)
# ──────────────────────────────────────────────
paper/figures/*.tmp
paper/figures/*.cache

# ──────────────────────────────────────────────
# DATASET IMAGES — DO NOT COMMIT (Esraa)
# ──────────────────────────────────────────────
# Raw / working images
dataset-b/raw/**/*.jpg
dataset-b/raw/**/*.jpeg
dataset-b/raw/**/*.png
dataset-b/working-Boreal-Forest-Fire-Subset-A/**/*.jpg
dataset-b/working-Boreal-Forest-Fire-Subset-A/**/*.jpeg
dataset-b/working-Boreal-Forest-Fire-Subset-A/**/*.png

# Generated YOLO images
dataset-b/yolo_format/images/**/*.jpg
dataset-b/yolo_format/images/**/*.jpeg
dataset-b/yolo_format/images/**/*.png

# Fire and Smoke Detection Dataset (unseen-fire test set)
dataset-a/test_dataset/
dataset-a/dataset/
dataset-a/raw/
dataset-a/processed/images/
*.jpeg
